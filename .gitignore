.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
*.egg-info/

# Bulk data: regenerated by the fetch/build scripts, far too large for git.
artifacts/raw/
artifacts/grids/
artifacts/*.log

# The runtime sqlite store is derived - data_store/*.csv is the durable copy.
artifacts/forecast_store.db
artifacts/forecast_store.db-wal
artifacts/forecast_store.db-shm

# Checkpoints are excluded EXCEPT the served CatBoost model (~2 MB), which the
# GitHub Actions cycle needs in the repo to produce a forecast at all. The torch
# checkpoints (26 MB) are training output and stay out.
artifacts/checkpoints/*
!artifacts/checkpoints/catboost_*.cbm
!artifacts/checkpoints/catboost_*.json

# Processed datasets are rebuildable; train_stats is small and describes the
# feature contract, so it travels with the code.
artifacts/processed/*
!artifacts/processed/train_stats_*.json

# Built static site - published to Pages as a deploy artifact, never committed.
site/
